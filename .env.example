# DealPilot AI: example settings (specs 004 and 006). Copy the variables you need into your
# shell or your own untracked .env file. The code reads the process environment only; it
# never loads a .env file. Never put a real key in this file.

# AI provider: mock (default, offline, no key), meta or gemini. A key alone never changes it.
DEALPILOT_AI_PROVIDER=mock
# Meta model ID. Only muse-spark-1.3 is supported for now. Not used by Gemini.
DEALPILOT_AI_MODEL=muse-spark-1.3
# Total request timeout in seconds, from 1 to 120 (shared by Meta and Gemini).
DEALPILOT_AI_TIMEOUT_SECONDS=30
# Meta Model API base URL (https only).
DEALPILOT_META_BASE_URL=https://api.meta.ai/v1
# Meta API key. Read only when DEALPILOT_AI_PROVIDER=meta. Leave empty here.
DEALPILOT_META_API_KEY=

# Google Gemini (spec 006). Read only when DEALPILOT_AI_PROVIDER=gemini. A first real call
# needs the checks of spec 006 section 9 (G1 to G4) and a separate authorization.
# GEMINI_API_KEY and GOOGLE_API_KEY are never read.
# Gemini API key. Leave empty here.
DEALPILOT_GEMINI_API_KEY=
# Model: gemini-3.5-flash-lite only; no default.
# DEALPILOT_GEMINI_MODEL=gemini-3.5-flash-lite
# What you send: synthetic or real (real only on a paid-tier project). Required.
# DEALPILOT_GEMINI_DATA_CLASS=synthetic
# Standard prices in USD per 1M tokens, above 0 and at most 1000. Required, no default.
# Reference in spec 006 D2: 0.30 input and 2.50 output; check the official pricing page
# again and set the date of that check.
# DEALPILOT_GEMINI_PRICE_INPUT_USD_PER_MTOK=
# DEALPILOT_GEMINI_PRICE_OUTPUT_USD_PER_MTOK=
# DEALPILOT_GEMINI_PRICES_CHECKED_ON=YYYY-MM-DD
# Gemini API base URL (https only).
# DEALPILOT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Paid-provider limits. Each may only lower its fixed maximum (the default).
# Input characters, 1 to 16000.
# DEALPILOT_AI_MAX_INPUT_CHARS=16000
# Output tokens, 1 to 1024.
# DEALPILOT_AI_MAX_OUTPUT_TOKENS=1024
# Budget in USD per UTC month, 0 to 5.00 (0 blocks every paid call).
# DEALPILOT_AI_MONTHLY_BUDGET_USD=5.00
# Calls per hour, 1 to 30.
# DEALPILOT_AI_MAX_CALLS_PER_HOUR=30
# Usage ledger folder; never data/raw or the sales data folder.
# DEALPILOT_AI_USAGE_DIR=data/ai-usage

# Sales data folder for the API (spec 002 D1). Default: data/raw.
# DEALPILOT_DATA_DIR=data/raw
